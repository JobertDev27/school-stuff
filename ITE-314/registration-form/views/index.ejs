<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link rel="stylesheet" href="css/styles.css">
</head>
<body>
<form method="POST" action="/register">
<div>
    <label>First Name:</label>
    <input type="text" name="fname" placeholder="fname" required /> 
</div>
<div>
    <label>Last Name:</label>
    <input type="text" name="lname" placeholder="lname" required /> 
</div>
<div>
    <label>Email Address:</label>
    <input type="email" name="email" placeholder="email" required /> 
</div>
<div>
    <label>Current Address:</label>
    <input type="text" name="address" placeholder="address" required /> 
</div>
<div>
    <label>Password:</label>
    <input type="password" name="pass" placeholder="pass" required /> 
</div>
<div>
    <label>Contact Number:</label>
    <input type="number" name="cnumber" placeholder="cnumber" required /> 
</div>
<a href="/login">Already have an Account? Login</a> 
<button type="submit">submit</button>
</form>
</body>
</html>

